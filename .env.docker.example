# Copy to .env.docker.local and fill in your device's PostgreSQL credentials.
# This configuration is for local HTTP Docker development only.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@host.docker.internal:5432/DATABASE_NAME
DATABASE_SSL_REQUIRE=0
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1
AI_INSIGHTS_ENABLED=0
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
