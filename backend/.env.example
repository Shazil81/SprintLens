# Reference only. This project does not automatically load .env files.
# Set real values in Render's secret environment settings, never commit them.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=YOUR_API_HOST.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://YOUR_FRONTEND.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/DATABASE_NAME
DATABASE_SSL_REQUIRE=1
DATABASE_CONN_MAX_AGE=60
REDIS_URL=redis://YOUR_PRIVATE_REDIS_HOST:6379/0
# Optional: defaults to REDIS_URL. The cache uses a sprintlens key prefix.
# CACHE_URL=redis://YOUR_PRIVATE_REDIS_HOST:6379/0
DJANGO_HSTS_SECONDS=3600
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
AI_INSIGHTS_ENABLED=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_DAILY_LIMIT=5
